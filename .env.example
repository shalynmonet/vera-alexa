# Copy this to /etc/vera/.env on the server (chmod 600, owned by the vera
# user) and fill in real values. Every var here is read by both
# server.py (the MCP server) and web/*.py (the web app) via
# EnvironmentFile= in the systemd units -- see deploy/DEPLOY.md.
#
# Nothing in this file is itself a secret -- it's the list of names. Never
# commit the real /etc/vera/.env.

# ---------- AWS (the vera-deploy IAM user) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---------- Security ----------
# One shared code the household enters once per device to use the app and
# the caregiver dashboard (family cheer links keep working with no code --
# their own private token is the auth). Leave unset to disable the login
# gate entirely (only ever do that for local dev).
VERA_ACCESS_CODE=

# A long random string the MCP server (server.py) requires as a bearer
# token on every request to /mcp, and the web app sends automatically.
# Leave unset to disable (only ever do that for local dev) -- generate one
# with: openssl rand -hex 32
VERA_MCP_TOKEN=

# ---------- Bedrock / Polly ----------
VERA_BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
VERA_POLLY_VOICE=Ruth
VERA_POLLY_ENGINE=neural
VERA_POLLY_RATE=92%

# ---------- Storage ----------
# S3 bucket for exercise/meditation videos and family cheer recordings.
# Required once the server runs somewhere its local disk doesn't persist
# across deploys (see README's "Known limitation"); optional otherwise --
# everything falls back to local disk under web/cheer_media/.
VERA_S3_BUCKET=
VERA_S3_PREFIX=

# ---------- Optional: email/SMS nudges ----------
VERA_SES_FROM_EMAIL=
VERA_SMS_ENABLED=false
VERA_SMS_ORIGINATION_NUMBER=

# ---------- Networking ----------
# Caddy (deploy/Caddyfile) terminates HTTPS and reverse-proxies to these
# ports on localhost -- leave both bound to 127.0.0.1, never 0.0.0.0, so
# neither server is reachable except through Caddy.
VERA_HOST=127.0.0.1
VERA_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=8080
VERA_MCP_URL=http://127.0.0.1:8000/mcp
VERA_CORS_ORIGINS=https://vera.sha-i.com

# ---------- Data ----------
VERA_DATA=/opt/vera/data/vera.json

# ---------- Rate limiting (requests per minute; defaults shown) ----------
# VERA_RATE_LIMIT_CHAT_PER_DEVICE=20
# VERA_RATE_LIMIT_CHAT_GLOBAL=200
# VERA_RATE_LIMIT_SPEAK_PER_DEVICE=40
# VERA_RATE_LIMIT_SPEAK_GLOBAL=400

# ---------- Judge demo profile ----------
# VERA_DEMO_USER_ID=judge_demo
